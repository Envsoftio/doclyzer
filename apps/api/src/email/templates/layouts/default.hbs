<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{brandName}}</title>
  </head>
  <body style="margin:0; padding:0; background:#f3f7f8; color:#17313a; font-family:Arial, Helvetica, sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">
      {{previewText}}
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f7f8; margin:0; padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%; max-width:640px; background:#ffffff; border:1px solid #dce8eb; border-radius:14px; overflow:hidden;">
            <tr>
              <td>
                {{> email-header}}
              </td>
            </tr>
            <tr>
              <td style="padding:32px 32px 8px 32px; font-size:15px; line-height:1.65; color:#24414a;">
                {{{content}}}
              </td>
            </tr>
            <tr>
              <td>
                {{> email-footer}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
