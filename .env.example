# Copy to .env and adjust. Used by API and docker compose.

# Database (API connects here; compose uses POSTGRES_* for the container)
DATABASE_URL=postgresql://doclyzer:doclyzer_dev_password@localhost:5432/doclyzer

# API
PORT=4002
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:4002
BETTER_AUTH_BASE_PATH=/v1/auth
BETTER_AUTH_SESSION_EXPIRES_IN_SECONDS=2592000
BETTER_AUTH_SESSION_UPDATE_AGE_SECONDS=86400
BETTER_AUTH_RESET_REDIRECT_URL=http://localhost:3005/reset-password
SUPERADMIN_EMAILS=admin@doclyzer.local
SUPERADMIN_MFA_TEST_CODE=654321
SUPERADMIN_MFA_CHALLENGE_TTL_SECONDS=300
SUPERADMIN_MFA_TRUST_TTL_SECONDS=600
SUPERADMIN_MFA_MAX_ATTEMPTS=5
SUPERADMIN_MFA_LOCKOUT_SECONDS=900

# Docker Postgres (optional; defaults shown)
POSTGRES_DB=doclyzer
POSTGRES_USER=doclyzer
POSTGRES_PASSWORD=doclyzer_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Background report processing requires durable B2 storage.
# Configure B2 credentials before starting the default Docker stack.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_REGION=us-west-002
B2_DISABLED=false

# Report worker and dispatcher start with the default Docker stack.
# Set acceptance=false only while draining or diagnosing the worker.
REPORT_ASYNC_RUNTIME_ENABLED=true
REPORT_ASYNC_ACCEPTANCE_ENABLED=true

# Optional, CPU-only PaddleOCR-VL shadow review. Start with COMPOSE_PROFILES=lab-vl.
# The default worker leaves this off. Model files are mounted read-only.
REPORT_VL_SHADOW_ENABLED=false
REPORT_VL_BASE_URL=http://paddleocr-vl:5006
REPORT_VL_API_KEY=
LAB_VL_BACKEND_API_KEY=
LAB_VL_SERVER_URL=http://vl-llama:8080/v1
LAB_VL_LAYOUT_MODEL_DIR=./.local-models/paddleocr-vl/PP-DocLayoutV3
LAB_VL_GGUF_MODEL_DIR=./.local-models/paddleocr-vl/gguf

# Share links (base URL used to construct share link URLs)
SHARE_BASE_URL=http://localhost:3005

# Razorpay (payment gateway for credit pack purchases)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=change-me-in-production
RAZORPAY_WEBHOOK_SECRET=change-me-in-production
RAZORPAY_PLAN_ID_PRO=plan_placeholder
REVENUECAT_WEBHOOK_AUTHORIZATION=change-me-in-production

# AI report summaries use only validated result values and the OpenAI key/model below.
REPORT_SUMMARY_ENABLED=true
REPORT_SUMMARY_TIMEOUT_MS=60000

# OpenDataLoader parser (optional)
OPENDATALOADER_ENABLED=true
OPENDATALOADER_CLI_COMMAND=opendataloader-pdf
OPENDATALOADER_TIMEOUT_MS=180000
OPENDATALOADER_EXTRA_ARGS=

# Docling native PDF service. JPEG/PNG uploads go directly to PaddleOCR.
DOCLING_OCR_ENABLED=true
DOCLING_OCR_BASE_URL=http://127.0.0.1:5002
DOCLING_OCR_TIMEOUT_MS=180000
DOCLING_OCR_ENGINE=tesseract
# Tesseract uses the fixed tesseract-table preset in docker-compose.yml.
# Rebuild Docling so its CLI, ONNX Runtime and table-rule wrapper are installed.
DOCLING_OCR_LANGUAGES=

# OpenAI key and endpoint shared by report narratives and unclear
# range/value checks. The model below is for extraction and range checks.
# The enabled flag is reserved for broad lab-row extraction; range/value checks use the key when present.
REPORT_LAB_AI_FALLBACK_ENABLED=false
REPORT_LAB_AI_FALLBACK_OPENAI_API_KEY=
REPORT_LAB_AI_FALLBACK_OPENAI_MODEL=gpt-6-luna
REPORT_LAB_AI_FALLBACK_OPENAI_BASE_URL=https://api.openai.com/v1
REPORT_LAB_AI_FALLBACK_TIMEOUT_MS=12000
REPORT_LAB_AI_FALLBACK_MIN_CONFIDENCE=0.72
REPORT_RESULT_INSIGHT_INPUT_PRICE_PER_MILLION=0.10
REPORT_RESULT_INSIGHT_OUTPUT_PRICE_PER_MILLION=0.50

# Patient-facing report summaries and individual result explanations.
# Keep this separate from the faster extraction/range-check model above.
REPORT_NARRATIVE_OPENAI_MODEL=gpt-6.1-sol
REPORT_NARRATIVE_INPUT_PRICE_PER_MILLION=2
REPORT_NARRATIVE_OUTPUT_PRICE_PER_MILLION=10

# Report narratives and automatic unclear range/value checks share the lab OpenAI key and base URL.
REPORT_RESULT_INSIGHT_TIMEOUT_MS=60000

# CPU PaddleOCR for JPEG/PNG uploads. Use the same nonempty key in the
# API/worker and paddleocr container. The model is bundled in the Docker image.
LAB_OCR_API_KEY=change-me-to-a-random-service-key
LAB_OCR_BASE_URL=http://127.0.0.1:5005
LAB_OCR_TIMEOUT_MS=130000
LAB_OCR_PAGE_TIMEOUT_SEC=120
LAB_OCR_WORKER_MAX_PAGES=25
REPORT_DEADLINE_MS=1800000
REPORT_DEADLINE_PER_PAGE_MS=130000
REPORT_DEADLINE_OVERHEAD_MS=600000

# Push: mock is for local development only; production dispatch fails closed.
PUSH_PROVIDER=mock
# Prefer managed application default credentials or a mounted secret file.
FCM_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Alternatively set these server-side values (never in mobile/web builds):
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Required by the existing broadcast approval policy. Set a strong random secret.
PUSH_ADMIN_APPROVAL_SECRET=
